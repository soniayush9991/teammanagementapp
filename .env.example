# ---- Core ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgres://teamspace:teamspace@localhost:5432/teamspace

# ---- Auth ----
# openssl rand -hex 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---- Retention ----
MESSAGE_RETENTION_DAYS=365
RETENTION_JOB_CRON_MINUTES=1440

# ---- Object storage (S3 compatible: AWS S3 / MinIO / R2) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=teamspace-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=26214400

# ---- Email (notifications) ----
SMTP_URL=
MAIL_FROM=no-reply@teamspace.local
